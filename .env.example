# =============================================================================
# Kariobangi Legends FC — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Core app
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database

# Public site URL used in SMS/WhatsApp tracking links and Open Graph shares
# Production example: https://kariobangilegends.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only alias (fallback if NEXT_PUBLIC_SITE_URL is unset)
# SITE_URL=https://kariobangilegends.co.ke

# -----------------------------------------------------------------------------
# Auth & sessions (use long random strings in production)
# -----------------------------------------------------------------------------
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string
CUSTOMER_SESSION_SECRET=change_me_to_a_long_random_string

# Full admin login password (hashed on first use if ADMIN_PASSWORD_HASH unset)
ADMIN_PASSWORD=change_me_strong_admin_password

# Press/news editor account
NEWSPAPER_USERNAME=newspaper
NEWSPAPER_PASSWORD=change_me_press_password

# Comma-separated phones allowed to reset admin password via SMS
ADMIN_RESET_PHONES=0723523254,0721916526

# -----------------------------------------------------------------------------
# Order notifications — SMS & WhatsApp
# -----------------------------------------------------------------------------
# Channels to use (comma-separated): sms, whatsapp
ORDER_NOTIFICATION_CHANNELS=sms,whatsapp

# Phones that receive admin alerts for new cash orders (comma-separated)
# Falls back to ADMIN_RESET_PHONES if unset
ORDER_ADMIN_PHONES=0723523254,0796230743

# --- WhatsApp provider ---
# Use Meta Cloud API for order status messages (recommended).
WHATSAPP_PROVIDER=meta
WHATSAPP_NOTIFY_MODE=live

# --- Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api ---
# 1. Create a Meta Business app with WhatsApp product enabled
# 2. Connect your club number (0796230743) as the WhatsApp Business number
# 3. Create & get approval for a UTILITY template (see WHATSAPP_TEMPLATE_NAME below)
# 4. Paste the permanent access token and Phone Number ID from Meta dashboard
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_API_VERSION=v21.0

# Approved Meta template for outbound order updates (UTILITY category).
# Template body example: "Hello! Order {{1}} is now {{2}}. {{3}}"
#   {{1}} = order number, {{2}} = status, {{3}} = tracking link
WHATSAPP_TEMPLATE_NAME=order_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# Display number shown in admin panel (your connected WhatsApp Business line)
WHATSAPP_BUSINESS_PHONE=0796230743

# --- Development only ---
# Set WHATSAPP_NOTIFY_MODE=log to print WhatsApp messages in the server console
# instead of sending them, while Meta credentials are being set up.
# WHATSAPP_NOTIFY_MODE=log

# --- SMS: Africa's Talking (Kenya) — https://africastalking.com ---
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_ENVIRONMENT=sandbox
# Sandbox only delivers to phone numbers registered in your AT dashboard.
# AFRICAS_TALKING_SANDBOX_SENDER_ID=your_sandbox_shortcode
# Production:
# AFRICAS_TALKING_USERNAME=your_live_app_username
# AFRICAS_TALKING_ENVIRONMENT=production
# AFRICAS_TALKING_SENDER_ID=KARIOBANGI

# --- Africa's Talking WhatsApp — only if WHATSAPP_PROVIDER=africas_talking ---
# WHATSAPP_AT_TEMPLATE_ID=your_africas_talking_whatsapp_template_id
# WHATSAPP_AT_TEMPLATE_HEADER=Kariobangi Legends FC

# -----------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja)
# -----------------------------------------------------------------------------
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_PASSKEY=your_mpesa_passkey
MPESA_ENVIRONMENT=sandbox
# Public HTTPS callback URL — must match your deployed domain
# Example: https://kariobangilegends.co.ke/api/mpesa/callback
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# -----------------------------------------------------------------------------
# Image uploads (Supabase Storage)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# Production checklist
# -----------------------------------------------------------------------------
# 1. Set DATABASE_URL to your PostgreSQL connection string
# 2. Set NEXT_PUBLIC_SITE_URL to your public HTTPS domain
# 3. Set ADMIN_SESSION_SECRET and CUSTOMER_SESSION_SECRET to random strings
# 4. Change ADMIN_PASSWORD and NEWSPAPER_PASSWORD from defaults
# 5. Add Africa's Talking API key + username for live SMS
# 6. Set WHATSAPP_PROVIDER=meta and add Meta Cloud API credentials
# 7. Create an approved Meta UTILITY template and set WHATSAPP_TEMPLATE_NAME
# 8. Set WHATSAPP_NOTIFY_MODE=live (remove log mode)
# 9. Set ORDER_ADMIN_PHONES so cash orders alert the club office
# 10. Set MPESA_CALLBACK_URL to your live /api/mpesa/callback URL
# 11. Switch MPESA_ENVIRONMENT=production when going live with Safaricom
