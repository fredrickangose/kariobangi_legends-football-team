# ===============================
# Order tracking notifications
# ===============================
# Enable one or both channels (comma-separated): sms, whatsapp
ORDER_NOTIFICATION_CHANNELS=sms,whatsapp

# Public website URL used in SMS/WhatsApp tracking links
# Example: https://kariobangilegends.co.ke
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===============================
# SMS — Africa's Talking (Kenya)
# https://africastalking.com
# ===============================
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key
AFRICAS_TALKING_USERNAME=your_africas_talking_username
# Optional registered sender ID or shortcode
AFRICAS_TALKING_SENDER_ID=KARIOBANGI

# ===============================
# WhatsApp — order progress updates to fans
# Default sender: 0796230743 (Kariobangi Legends)
# Uses Africa's Talking when SMS credentials are set below.
# Optional Meta Cloud API overrides Africa's Talking if both are configured.
# ===============================
WHATSAPP_BUSINESS_PHONE=0796230743
# Set to "log" to print WhatsApp messages in the server console during development
WHATSAPP_NOTIFY_MODE=log

# Optional Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Optional approved template for production Meta WhatsApp messages
# Template body example: "Hello! Order {{1}} is now {{2}}. {{3}}"
WHATSAPP_TEMPLATE_NAME=order_status_update
WHATSAPP_TEMPLATE_LANGUAGE=en

# ===============================
# Existing app variables (keep your values)
# ===============================
# DATABASE_URL=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# NEWSPAPER_USERNAME=newspaper
# NEWSPAPER_PASSWORD=Kariobangi2026!
# CUSTOMER_SESSION_SECRET=
# Optional authorized manager phone(s) for admin password reset (comma-separated)
# ADMIN_RESET_PHONES=0723523254
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_ENVIRONMENT=sandbox
